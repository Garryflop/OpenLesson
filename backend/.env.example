# ---------------- OpenLesson backend configuration ----------------
ENVIRONMENT=development              # production: enables strict checks
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=sqlite:///./openlesson.db
# DATABASE_URL=postgresql+psycopg://openlesson:password@localhost:5432/openlesson
FRONTEND_URL=http://localhost:5173
TIMEZONE=Asia/Almaty

# ---- Authentication: OpenID Connect (Microsoft Entra ID / Outlook) ----
# Azure portal -> App registrations -> New registration
#   Redirect URI (Web): http://localhost:5173/api/auth/callback
#   Certificates & secrets -> New client secret
OIDC_PROVIDER_NAME=Microsoft
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
OIDC_SCOPES=openid email profile
ALLOWED_EMAIL_DOMAINS=astanait.edu.kz
ADMIN_EMAILS=
AUTO_CREATE_USERS=true
DEV_LOGIN_ENABLED=true               # demo sign-in without OIDC; must be false in production

# ---- E-mail: console | smtp | graph ----
EMAIL_BACKEND=console
EMAIL_FROM=openlesson@astanait.edu.kz
EMAIL_FROM_NAME=OpenLesson AITU
# Microsoft Graph (recommended for Outlook / Exchange Online). App permission: Mail.Send
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=openlesson@astanait.edu.kz
# SMTP alternative
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- AI Assistant: OpenAI API (ChatGPT) or a local LLM (Ollama / LM Studio / vLLM) ----
# Without a key (openai) or a running local server the transparent rule-based analyser is used.
#   AI_PROVIDER: openai | local
#   AI_API_KEY:  OpenAI key (not needed for a local LLM)
#   AI_BASE_URL: empty = https://api.openai.com/v1 (openai) or http://localhost:11434/v1 (local, Ollama);
#                LM Studio: http://localhost:1234/v1
#   AI_MODEL:    empty = gpt-4o-mini (openai) or qwen2.5:7b (local)
AI_ENABLED=true
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ---- Automation ----
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
